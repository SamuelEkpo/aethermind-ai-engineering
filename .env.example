# ---------------------------------------------------------------------------
# AetherMind — environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=AetherMind
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
POSTGRES_USER=aethermind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aethermind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aethermind:change-me@localhost:5432/aethermind

# --- Cache / Queue (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Experiment Tracking (MLflow) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Model / Training ---
MODEL_CHECKPOINT_DIR=training/checkpoints
TOKENIZER_VOCAB_SIZE=32000
DEVICE=cpu                     # cpu | cuda | mps

# --- Optional external model (any OpenAI-compatible /chat/completions server) ---
# Disabled unless BOTH base URL and model are set. Requests only reach it when a
# caller passes {"model": "external"} to /v1/generate, or EXTERNAL_FALLBACK=true
# (then it is tried if the local AetherMind model fails). Off by default so
# private code is not sent off-box unless you opt in.
# EXTERNAL_LLM_BASE_URL=http://localhost:8001/v1
# EXTERNAL_LLM_MODEL=
# EXTERNAL_LLM_API_KEY=
# EXTERNAL_LLM_TIMEOUT=30
# EXTERNAL_FALLBACK=false

# --- Optional open-weight model integration ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACE_TOKEN=
